# Copy to .env (never commit it).

# anthropic: the API, needs ANTHROPIC_API_KEY.
# claude_code: the local Claude Code CLI (headless), uses this machine's Claude Code login.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

LLM_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=60
AGENT_MAX_STEPS=8
TOOL_TIMEOUT_SECONDS=10
MAX_INPUT_CHARS=4000

# Tracing is off unless one of these blocks is filled in.
# Langfuse (takes precedence):
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Any OpenTelemetry collector:
OTLP_ENDPOINT=
OTLP_HEADERS=
