# Parameters of the local Docker stack (`make up`, `make dev`). Committed on purpose: these
# are throwaway credentials for containers bound to 127.0.0.1, never real secrets. Real keys
# (ANTHROPIC_API_KEY, a cloud Langfuse project) go in .env, which is not committed.

# Address and ports the API and the Langfuse UI are published on
BIND_ADDR=127.0.0.1
APP_PORT=8000
LANGFUSE_PORT=3000

# Local Langfuse: the project and login are created on first start with these values.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_PROJECT_NAME=fde-poc
LANGFUSE_USER_EMAIL=dev@local.test
LANGFUSE_USER_PASSWORD=Localdev-1234
