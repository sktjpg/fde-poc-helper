# Run the Docker stack on another machine instead of this one. Copy to docker/<name>.env
# (ignored by git), fill it in, then: make up STACK=<name>  and  make dev STACK=<name>.
# Images, containers and trace data live on that machine; this one only needs the docker CLI.

# Where Docker runs: an SSH host from ~/.ssh/config whose user can run docker.
DOCKER_HOST=ssh://my-server

# Nothing is published to the network: Langfuse listens on that machine's loopback and
# `make up` opens an SSH tunnel, so it is http://localhost:<LANGFUSE_PORT> here. The traces
# contain prompts and tool arguments. Each forward is "local_port:remote_host:remote_port".
SSH_TUNNEL=my-server
TUNNEL_FORWARDS="3000:127.0.0.1:3000"
BIND_ADDR=127.0.0.1
APP_PORT=8000
LANGFUSE_PORT=3000
LANGFUSE_HOST=http://localhost:3000

# The project and login created on first start.
# Generate the keys and the password: openssl rand -hex 16
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
LANGFUSE_PROJECT_NAME=fde-poc
LANGFUSE_USER_EMAIL=dev@local.test
LANGFUSE_USER_PASSWORD=

# Optional: run the agent on a model served on that machine (Ollama, vLLM, ...). Add its
# port to TUNNEL_FORWARDS, e.g. "3000:127.0.0.1:3000 11434:127.0.0.1:11434". `make dev`
# exports these, and they win over .env. Prices are USD per million tokens: a self-hosted
# model has no bill per token, so set what you want the cost tracking to show.
#LLM_PROVIDER=openai_compatible
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_MODEL=qwen2.5:14b
#LLM_MAX_TOKENS=2048
#LLM_INPUT_PRICE_PER_MTOK=0
#LLM_OUTPUT_PRICE_PER_MTOK=0
