# Run the Docker stack on another machine instead of this one. Copy to docker/<name>.env
# (ignored by git), fill it in, then: make up STACK=<name>  and  make dev STACK=<name>.
# Images, containers and trace data live on that machine; this one only needs the docker CLI.

# Where Docker runs: an SSH host from ~/.ssh/config whose user can run docker.
DOCKER_HOST=ssh://my-server

# Address on that machine to publish on. Use a private one (VPN or Tailscale), never
# 0.0.0.0: the traces contain prompts and tool arguments.
BIND_ADDR=100.64.0.1
APP_PORT=8000
LANGFUSE_PORT=3000

# How this machine reaches that Langfuse, and the project and login created on first start.
# Generate the keys and the password: openssl rand -hex 16
LANGFUSE_HOST=http://100.64.0.1:3000
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
LANGFUSE_PROJECT_NAME=fde-poc
LANGFUSE_USER_EMAIL=dev@local.test
LANGFUSE_USER_PASSWORD=
